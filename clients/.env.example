# ─── APIM Gateway (all requests routed through APIM) ─────────────────────────
APIM_GATEWAY_URL=https://<your-apim-name>.azure-api.net/<your-foundry-resource>
APIM_SUBSCRIPTION_KEY=<your-apim-subscription-key>
OPENAI_API_VERSION=2025-01-01-preview

# ─── Direct Foundry / Azure OpenAI (bypass APIM) ─────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<foundry-resource-name>.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=<az cognitiveservices account keys list --name NAME --resource-group RG --query key1 -o tsv>

# ─── Model deployment names ───────────────────────────────────────────────────
DEPLOYMENT_GPT5_MINI=<your-gpt-deployment-name>
DEPLOYMENT_KIMI=<your-kimi-deployment-name>
