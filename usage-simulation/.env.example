# ── APIM Gateway ─────────────────────────────────────────────────────────────
# The AzureOpenAI SDK appends /openai/ automatically — use the base URL.
APIM_GATEWAY_URL=https://<your-apim-name>.azure-api.net
OPENAI_API_VERSION=2025-01-01-preview

# ── Deployment names available through APIM ──────────────────────────────────
DEPLOYMENT_GPT=<your-gpt-deployment-name>
DEPLOYMENT_KIMI=<your-kimi-deployment-name>

# ── Per-user APIM subscription keys ──────────────────────────────────────────
# Each key maps to an APIM subscription scoped to the Foundry API.
# Usage is tracked per key → per user in Azure Monitor & APIM analytics.
# Retrieve keys: az rest --method POST --uri "https://management.azure.com/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.ApiManagement/service/<apim>/subscriptions/<name>/listSecrets?api-version=2022-08-01" --query primaryKey -o tsv
PETER_PARKER_KEY=<apim-subscription-key-for-peter>
TONNY_STARK_KEY=<apim-subscription-key-for-tonny>
SON_GOKU_KEY=<apim-subscription-key-for-goku>
MONKEY_D_LUFFY_KEY=<apim-subscription-key-for-luffy>
