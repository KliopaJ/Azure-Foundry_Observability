# Azure Entra ID (required for multi-user auth)
AZURE_CLIENT_ID=<app-registration-client-id>
AZURE_TENANT_ID=<your-tenant-id>

# APIM settings (for policy management)
# APIM_SERVICE_NAME: az apim list --query "[].name" -o tsv
# APIM_API_ID: az apim api list --service-name <apim> --resource-group <rg> --query "[].name" -o tsv
# APIM_BACKEND_ID: az rest --method GET --uri "https://management.azure.com/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.ApiManagement/service/<apim>/backends?api-version=2022-08-01" --query "value[].name" -o tsv
APIM_SERVICE_NAME=<your-apim-service-name>
APIM_SUBSCRIPTION_ID=<azure-subscription-id-containing-apim>
APIM_RESOURCE_GROUP=<resource-group-containing-apim>
APIM_API_ID=<your-api-id>
APIM_BACKEND_ID=<your-backend-id>
DEFAULT_TPM=100000
